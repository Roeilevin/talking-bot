# Bein Harim API — production (default) credentials
BH_API_BASE_URL=https://dev-v3.beinharimtours.com/api/v2
BH_API_KEY=your_bh_api_key
# Bein Harim API — test/dev credentials. The dashboard "Bein Harim data" toggle
# switches the bot between these and the production pair at runtime.
BH_API_BASE_URL_TEST=https://dev-v3.beinharimtours.com/api/v2
BH_API_KEY_TEST=your_bh_test_api_key

# Telnyx
TELNYX_API_KEY=your_telnyx_api_key
TELNYX_PHONE_NUMBER=your_telnyx_phone_number
TELNYX_CALL_CONTROL_APP_ID=your_call_control_app_id
TELNYX_ASSISTANT_ID=your_assistant_id
# Inbound support assistant id (filters the dashboard's inbound-call list)
TELNYX_INBOUND_ASSISTANT_ID=assistant-xxxxxxxx

# Converto (WhatsApp BSP)
CONVERTO_API_KEY=your_converto_api_key
CONVERTO_PHONE_NUMBER=+972526588834
CONVERTO_WEBHOOK_SECRET=your_webhook_signing_secret

# WhatsApp number that receives call status updates for the guide/ops team
# (defaults to CONVERTO_PHONE_NUMBER if unset)
OPS_WHATSAPP_NUMBER=972526588834

# Transfer target
TRANSFER_PHONE_NUMBER=972504425422

# Public URL (for Telnyx AI assistant webhooks)
PUBLIC_BASE_URL=https://your-domain.vercel.app

# Supabase (call/message history for the /dashboard page)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Publishable (or legacy anon) key — used only for dashboard sign-in via
# Supabase Auth. Supabase dashboard → Project Settings → API Keys.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Optional hard allowlist of emails permitted to sign in. Normally leave this
# UNSET: access is granted per-account from the /users screen, which stamps
# `dashboard_access` into the account's app_metadata. Setting this overrides
# that entirely — only the listed emails get in, including accounts added later
# from /users. Use it as a lockdown switch, not the everyday mechanism.
# DASHBOARD_ALLOWED_EMAILS=you@example.com
